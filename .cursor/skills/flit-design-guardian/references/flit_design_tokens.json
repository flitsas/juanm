{
  "source": "DESIGNS/flitready-suite/src/styles.css",
  "target": "frontend/src/app/globals.css",
  "tokens": {
    "--lime": "--flit-lime",
    "--action": "--flit-action",
    "--deep": "--flit-text-primary",
    "--tech": "--flit-tech",
    "--purple-acc": "--flit-purple",
    "--amber-acc": "--flit-amber",
    "--alert": "--flit-state-danger",
    "--table-head": "--flit-table-head",
    "--gradient-flit": "--flit-gradient-flit",
    "--background": "--flit-bg-app",
    "--card": "--flit-bg-card"
  },
  "cssClasses": {
    "Card": "flit-card",
    "Button primary": "flit-btn-primary / PrimaryButton",
    "Table": "flit-table",
    "Badge": "flit-badge / StatusBadge",
    "Input": "flit-input"
  },
  "typography": {
    "fontFamily": "Poppins via --font-poppins in layout.tsx",
    "weights": [300, 400, 500, 700]
  }
}
