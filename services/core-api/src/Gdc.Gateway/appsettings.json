{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "core-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "hubs": {
        "ClusterId": "core-api",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "core-api": {
        "Destinations": {
          "core-api": {
            "Address": "http://core-api:8081/"
          }
        }
      }
    }
  }
}
