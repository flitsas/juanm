{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "Core": "Host=localhost;Port=5432;Database=flitReady_local;Username=postgres;Password=flitdb;SSL Mode=Disable"
  },
  "Jwt": {
    "Issuer": "gdc-core-api-dev",
    "Audience": "gdc-frontend-dev",
    "SecretKey": "dev-only-secret-key-min-32-characters-long",
    "AccessTokenMinutes": 15
  },
  "Smtp": {
    "Enabled": true,
    "EnableSsl": true
  },
  "Auth": {
    "Invitation": {
      "ActivationTokenHours": 48,
      "ActivationBaseUrl": "http://localhost:40103/activate"
    },
    "PasswordRecovery": {
      "ResetTokenHours": 48,
      "ResetBaseUrl": "http://localhost:40103/reset-password"
    }
  },
  "Dgc": {
    "VehicleRegistry": {
      "Provider": "Renting"
    },
    "ContraventorJob": {
      "Enabled": true,
      "PollIntervalMinutes": 1
    }
  },
  "Reglas": {
    "Execution": {
      "Enabled": true,
      "PollIntervalSeconds": 60,
      "BatchSize": 50
    }
  }
}
